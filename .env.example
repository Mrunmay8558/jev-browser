# Copy this file to .env. Keep your key on the server, never in jev_lab/static/.
TYPESAFE_API_KEY=
# Pin the model while evaluating thresholds. Change intentionally when upgrading.
JEV_MODEL=jev-1.13.0
PORT=4317

# Multi-step agent: Gemini proposes actions; Jev evaluates them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Uses a separate persistent profile, not your default Chrome profile.
BROWSER_CHANNEL=chrome
BROWSER_PROFILE_DIR=.runtime/browser-profile
BROWSER_DWELL_MS=450
